{
  "manifest_version": 3,
  "name": "Playlist & GitHub Bookmarks",
  "version": "1.1.1",
  "description": "Mirror YouTube playlists and GitHub Lists as organized Chrome bookmarks.",
  "permissions": ["bookmarks", "storage", "alarms"],
  "host_permissions": ["https://www.youtube.com/*"],
  "optional_host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Playlist & GitHub Bookmarks",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
